<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_milk_delivery_sheet_list" model="ir.ui.view">
        <field name="name">tr.milk.delivery.sheet.list</field>
        <field name="model">tr.milk.delivery.sheet</field>
        <field name="arch" type="xml">
            <list string="Delivery Sheets"
                  decoration-success="state=='done'"
                  decoration-info="state=='confirmed'"
                  decoration-muted="state=='draft'">
                <field name="name"/>
                <field name="delivery_date"/>
                <field name="route_id"/>
                <field name="driver_id"/>
                <field name="delivery_count" string="Total"/>
                <field name="delivered_count" string="Delivered"/>
                <field name="skipped_count" string="Skipped"/>
                <field name="state" widget="badge"
                       decoration-success="state=='done'"
                       decoration-info="state=='confirmed'"
                       decoration-muted="state=='draft'"/>
            </list>
        </field>
    </record>

    <record id="view_milk_delivery_sheet_form" model="ir.ui.view">
        <field name="name">tr.milk.delivery.sheet.form</field>
        <field name="model">tr.milk.delivery.sheet</field>
        <field name="arch" type="xml">
            <form string="Delivery Sheet">
                <header>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done"
                            type="object" class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state == 'done'"/>
                    <button name="action_print_sheet" string="🖨 Print Sheet"
                            type="object"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="route_id"/>
                            <field name="driver_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="delivery_date"/>
                            <field name="delivered_count" readonly="1"/>
                            <field name="delivery_count" readonly="1"/>
                        </group>
                    </group>
                    <div class="mb-2">
                        <button name="action_mark_all_delivered"
                                type="object"
                                string="✓ Mark All Delivered"
                                class="btn btn-sm btn-outline-success"
                                invisible="state == 'done'"/>
                    </div>
                    <field name="delivery_ids" widget="one2many_list">
                        <list editable="bottom"
                              decoration-success="state=='delivered'"
                              decoration-warning="state=='skipped'"
                              decoration-danger="state=='absent'">
                            <field name="partner_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="qty"/>
                            <field name="price_unit"/>
                            <field name="subtotal" readonly="1"/>
                            <field name="note" optional="show"/>
                            <field name="state" widget="badge"
                                   decoration-success="state=='delivered'"
                                   decoration-warning="state=='skipped'"
                                   decoration-danger="state=='absent'"
                                   decoration-muted="state=='pending'"/>
                            <button name="action_deliver" type="object"
                                    string="✓" title="Mark Delivered"
                                    class="btn btn-sm btn-success"
                                    invisible="state == 'delivered'"/>
                            <button name="action_skip" type="object"
                                    string="Skip" title="Skip"
                                    class="btn btn-sm btn-warning"
                                    invisible="state != 'pending'"/>
                            <field name="invoiced" readonly="1" optional="hide"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_milk_delivery_sheet_search" model="ir.ui.view">
        <field name="name">tr.milk.delivery.sheet.search</field>
        <field name="model">tr.milk.delivery.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="route_id"/>
                <field name="driver_id"/>
                <filter name="today" string="Today"
                        domain="[('delivery_date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <group>
                    <filter name="group_date" string="Date" context="{'group_by': 'delivery_date'}"/>
                    <filter name="group_route" string="Route" context="{'group_by': 'route_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_milk_delivery_sheet" model="ir.actions.act_window">
        <field name="name">Delivery Sheets</field>
        <field name="res_model">tr.milk.delivery.sheet</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_milk_delivery_sheet_search"/>
    </record>

</odoo>
