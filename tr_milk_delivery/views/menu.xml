              name="Milk Delivery"
              sequence="85"
              web_icon="tr_milk_delivery,static/description/icon.png"/>

    <!-- Operations -->
    <menuitem id="menu_milk_operations"
              name="Operations"
              parent="menu_milk_delivery_root"
              sequence="10"/>

    <menuitem id="menu_milk_delivery_sheet"
