<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_milk_route_list" model="ir.ui.view">
        <field name="name">tr.milk.route.list</field>
        <field name="model">tr.milk.route</field>
        <field name="arch" type="xml">
            <list string="Delivery Routes">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="mon" widget="boolean_toggle"/>
                <field name="tue" widget="boolean_toggle"/>
                <field name="wed" widget="boolean_toggle"/>
                <field name="thu" widget="boolean_toggle"/>
                <field name="fri" widget="boolean_toggle"/>
                <field name="sat" widget="boolean_toggle"/>
                <field name="sun" widget="boolean_toggle"/>
                <field name="active_subscription_count" string="Active Subs"/>
            </list>
        </field>
    </record>

    <record id="view_milk_route_form" model="ir.ui.view">
        <field name="name">tr.milk.route.form</field>
        <field name="model">tr.milk.route</field>
        <field name="arch" type="xml">
            <form string="Delivery Route">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subscriptions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="active_subscription_count" widget="statinfo" string="Active Subs"/>
                        </button>
                        <button name="action_view_driver_portal"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-mobile">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Driver App</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Route Name"/></h1>
                    </div>
                    <group>
                        <group string="Route Info">
                            <field name="driver_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Delivery Days">
                            <field name="mon" widget="boolean_toggle"/>
                            <field name="tue" widget="boolean_toggle"/>
                            <field name="wed" widget="boolean_toggle"/>
                            <field name="thu" widget="boolean_toggle"/>
                            <field name="fri" widget="boolean_toggle"/>
                            <field name="sat" widget="boolean_toggle"/>
                            <field name="sun" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Driver Portal">
                        <field name="access_token" readonly="1"/>
                        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:4px;">
                            <button name="action_generate_token" type="object"
                                    string="🔑 Generate Link" class="btn btn-sm btn-outline-primary"/>
                            <button name="action_view_driver_portal" type="object"
                                    string="📱 Open App" class="btn btn-sm btn-outline-secondary"
                                    invisible="not access_token"/>
                            <button name="action_get_qr_code" type="object"
                                    string="📷 Show QR Code" class="btn btn-sm btn-outline-info"
                                    invisible="not access_token"/>
                            <button name="action_send_driver_whatsapp" type="object"
                                    string="💬 Send to Driver (WhatsApp)" class="btn btn-sm btn-success"
                                    invisible="not access_token"/>
                        </div>
                    </group>
                    <group string="Coverage Area">
                        <field name="area_description" nolabel="1"
                               placeholder="e.g. Sector 15, 16, 17 — Model Town — Streets A to F&#10;Describe all localities this driver covers so new customers can be assigned correctly."/>
                    </group>
                    <group string="Internal Notes">
                        <field name="note" nolabel="1" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_milk_route" model="ir.actions.act_window">
        <field name="name">Delivery Routes</field>
        <field name="res_model">tr.milk.route</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
